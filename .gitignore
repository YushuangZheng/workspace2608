# Python caches and build products
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Pinned third-party research worktrees are fetched separately and must not be
# vendored into this repository (see integrations/rlbench/THIRD_PARTY.md).
/RLBench/
/TAPAS/
/PyRep/
/RoboTwin/
/RoboDojo/
/CoppeliaSim_Edu_V4_1_0_Ubuntu20_04/

# External baseline sources and local reproduction artifacts. Track only the
# surrounding provenance, environment manifests, configs, and wrapper scripts.
/baselines/*/upstream/
/baselines/*/data/
/baselines/*/datasets/
/baselines/*/checkpoints/
/baselines/*/results/
/baselines/*/runtime/
/baselines/*/env/
/baselines/*/envs/
/baselines/*/.conda/

# Reference papers and demonstration bundles stay local.
/DynaMAC.pdf
/MiDiGaP.pdf
/papers/*.pdf
/data/

# Local experiment outputs
outputs/
/output/
/tmp/
integrations/rlbench/models/
integrations/rlbench/results/
*.log
*.tmp

# RLBench demonstrations are large, simulator-generated artifacts.  Keep only
# the protocol note in Git; collection manifests belong with the local data.
integrations/rlbench/data/**
!integrations/rlbench/data/README.md

# Local tooling
.venv/
**/.env
**/.env.*
!**/.env.example
.DS_Store
ESSAY2608_FILE_TREE_*.json
