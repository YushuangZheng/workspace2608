# Python caches, reports, and build products
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/

# Local Python environments and secrets
.venv/
venv/
.direnv/
.env
.env.*
!.env.example
*.pem
*.key

# Editor and operating-system state
.idea/
.vscode/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Pinned third-party research worktrees are fetched separately and must not be
# vendored into this repository (see integrations/rlbench/THIRD_PARTY.md).
/RLBench/
/TAPAS/
/PyRep/
/RoboTwin/
/RoboDojo/
/tapas_env/
/tapas_venv/
/CoppeliaSim_Edu_V4_1_0_Ubuntu20_04/
/CoppeliaSim_Edu_V4_1_0_Ubuntu20_04.tar
/CoppeliaSim_Edu_V4_1_0_Ubuntu20_04.tar.*

# Local manuscript, research notes, reference papers, and unrelated top-level
# data stay outside the code repository. The root project README is the only
# tracked Markdown document at this level.
/*.md
!/README.md
/*.pdf
/*.zip
/iclr2027/
/data/

# Local experiment outputs and release bundles
/outputs/
/artifacts/
/release-artifacts/
/tmp/
/iclr2027/tmp/
wandb/
lightning_logs/
*.log
*.pid
*.tmp
*.temp

# LaTeX build products
/iclr2027/*.aux
/iclr2027/*.bbl
/iclr2027/*.blg
/iclr2027/*.fdb_latexmk
/iclr2027/*.fls
/iclr2027/*.lof
/iclr2027/*.lot
/iclr2027/*.out
/iclr2027/*.soc
/iclr2027/*.synctex.gz
/iclr2027/*.toc
/iclr2027/*.upa
/iclr2027/*.upb

# RLBench data: commit the complete sealed evaluation set and only the five
# authenticated training manifests. Raw demonstration pickles are distributed
# with the baseline release rather than through normal Git history.
/integrations/rlbench/data/**
!/integrations/rlbench/data/README.md
!/integrations/rlbench/data/evaluation/
!/integrations/rlbench/data/evaluation/manifest.json
!/integrations/rlbench/data/evaluation/spec.json
!/integrations/rlbench/data/evaluation/environment/
!/integrations/rlbench/data/evaluation/environment/*.json
!/integrations/rlbench/data/evaluation/coordination/
!/integrations/rlbench/data/evaluation/coordination/*.json
!/integrations/rlbench/data/training/
!/integrations/rlbench/data/training/manifest.json
!/integrations/rlbench/data/training/main/
!/integrations/rlbench/data/training/main/collection_manifest.json
!/integrations/rlbench/data/training/main/bimanual_put_bottle_in_fridge/
!/integrations/rlbench/data/training/main/bimanual_put_bottle_in_fridge/collection_manifest.json
!/integrations/rlbench/data/training/main/bimanual_sweep_to_dustpan/
!/integrations/rlbench/data/training/main/bimanual_sweep_to_dustpan/augmentation_manifest.json
!/integrations/rlbench/data/training/coordination/
!/integrations/rlbench/data/training/coordination/collection_manifest.json

# Model weights and per-task training metadata are release artifacts. Keep the
# compact V4 inventory in Git so a checkout can authenticate downloaded models.
/integrations/rlbench/models/**
!/integrations/rlbench/models/v4/
!/integrations/rlbench/models/v4/release_manifest.json

# Raw formal results, diagnostics, replay manifests, and videos are generated
# artifacts (some JSON files exceed GitHub's normal per-file limit).
/integrations/rlbench/results/**

# Evaluation datasets, model/training artifacts, generated results, and
# rollout results remain local. Source schemas, manifests, runners, analysis
# code, and tests stay tracked.
/evaluations/iclr2027/datasets/
/evaluations/iclr2027/artifacts/
/evaluations/iclr2027/results/**

# Native RVT/RACER execution stacks, machine identities, and run evidence are
# maintained outside this source repository. Retain only the simulator-facing
# adapter used by the TSF Native-6 runner.
/evaluations/iclr2027/native_systems/**
!/evaluations/iclr2027/native_systems/rvt/
!/evaluations/iclr2027/native_systems/rvt/e6_v3/
!/evaluations/iclr2027/native_systems/rvt/e6_v3/physics.py
!/evaluations/iclr2027/native_systems/rvt/e6_v3/amendment2.py
!/evaluations/iclr2027/native_systems/rvt/e6_v3/mapping/
!/evaluations/iclr2027/native_systems/rvt/e6_v3/mapping/candidate_filter.py
/evaluations/iclr2027/native6_v3/*.md
!/evaluations/iclr2027/native6_v3/README.md

# Only pinned notices and lock files belong under third_party. Source trees,
# archives, conda prefixes, compiled extensions, and overlays remain local.
/integrations/rlbench/third_party/**
!/integrations/rlbench/third_party/pytracik/
!/integrations/rlbench/third_party/pytracik/LICENSE
!/integrations/rlbench/third_party/pytracik/conda-linux-64-cp38.lock

# Local tooling
ESSAY2608_FILE_TREE_*.json
