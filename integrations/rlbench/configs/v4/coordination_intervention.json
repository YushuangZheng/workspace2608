{
  "schema": "rlbench-dynamac-coordination-intervention-v4",
  "release": "v4",
  "task": "bimanual_handover_item_dynamic",
  "scenarios": [
    "coordination_hand_left",
    "coordination_hand_right"
  ],
  "trigger": {
    "clock": "successfully_committed_policy_ticks",
    "global_tick": 235,
    "application_timing": "on_policy_action_at_global_tick_before_environment_step"
  },
  "motion": {
    "target_source": "predicted_absolute_end_effector_action",
    "translation_frame": "world",
    "translation_m": [
      0.0,
      0.0,
      0.03
    ],
    "smooth_policy_ticks": 10,
    "smooth_fractions": "1_over_n_through_n_over_n",
    "orientation": "unmodified_policy_target",
    "other_arm": "unmodified_policy_target",
    "both_grippers": "unmodified_policy_target",
    "application": "fractional_offset_during_smooth_window_then_hold_final_offset",
    "persistent_policy_target_offset": true
  },
  "clock_semantics": {
    "policy_requests_during_smooth_window": 10,
    "policy_clock_advances_during_smooth_window": true,
    "policy_action_and_intervention_share_one_transaction": true,
    "observation_refreshed_by_each_committed_policy_step": true
  },
  "invalid_action": {
    "max_primary_action_attempts_per_policy_tick": 1,
    "solver": "global_pseudo_trac_sampling_path_formal_v1",
    "failure_behavior": "commit_joint_hold_and_advance_same_policy_tick"
  },
  "provenance": {
    "result_based_retuning_forbidden": true,
    "legacy_v3_profile_unchanged": true
  }
}
